<resources>
    <!-- Base application theme. -->
    <style name="Theme.TSBattery" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimaryAccent</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorPrimaryAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryAccent</item>
        <item name="colorOnSecondary">@color/colorThemeBackground</item>
        <item name="colorAccent">@color/colorPrimaryAccent</item>
        <item name="colorControlHighlight">@color/colorPrimaryTint</item>
        <item name="colorOnSurface">@color/colorTextGray</item>
        <item name="colorSurfaceVariant">@color/colorPrimaryTint</item>
        <item name="colorOnSurfaceVariant">@color/colorTextDark</item>
        <item name="colorSecondaryContainer">@color/colorPrimaryTintTertiary</item>
        <item name="colorOnSecondaryContainer">@color/colorTextGray</item>
        <item name="checkboxStyle">@style/Widget.TSBattery.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.TSBattery.RadioButton</item>
        <item name="android:textColorPrimary">@color/colorTextGray</item>
        <item name="android:textColorSecondary">@color/colorTextDark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TSBattery.MaterialAlertDialog</item>
        <item name="colorSurfaceInverse">@color/colorSnackbarBackground</item>
        <item name="colorOnSurfaceInverse">@color/colorSnackbarText</item>
        <item name="colorPrimaryInverse">@color/colorSnackbarAction</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorThemeBackground</item>
        <!-- Dialog background color. -->
        <item name="colorSurfaceContainerHigh">@color/colorCard</item>
        <!-- Text highlight color. -->
        <item name="android:textColorHighlight">@color/colorTextHighlight</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="MaterialAlertDialog.TSBattery.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/colorTextDark</item>
    </style>

    <style name="ThemeOverlay.TSBattery.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.TSBattery.Body.Text</item>
        <item name="colorOnSurface">@color/colorTextGray</item>
        <item name="colorOnSurfaceVariant">@color/colorTextDark</item>
        <item name="android:textColorPrimary">@color/colorTextGray</item>
        <item name="android:textColorSecondary">@color/colorTextDark</item>
    </style>

    <style name="Widget.TSBattery.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorNavIndicator</item>
    </style>
    <style name="Widget.TSBattery.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textColor">@color/colorTextGray</item>
    </style>

    <style name="Widget.TSBattery.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:textColor">@color/colorTextGray</item>
    </style>

</resources>